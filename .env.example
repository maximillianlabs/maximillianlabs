# Site
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Contact form — displayed on the contact page
NEXT_PUBLIC_CONTACT_EMAIL=hello@your-domain.com

# Resend — required for sending contact form emails
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY=

# Sender address — must use a domain verified in Resend
# Example: Contact Form <noreply@your-domain.com>
CONTACT_FORM_FROM=Contact Form <noreply@your-domain.com>

# Recipient override (optional — defaults to NEXT_PUBLIC_CONTACT_EMAIL)
CONTACT_FORM_TO=hello@your-domain.com
